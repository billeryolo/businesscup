# Copy to .env.local for local development, and add the same values in Vercel →
# Project → Settings → Environment Variables (Production and Preview).

# Accounts (optional). Without them the free check still works; sign-in and progress are hidden.
# Supabase → Project Settings → API Keys: the Project URL and the publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. "The app listens" in the reading check: the speech service from speech/app.py on
# Modal (see speech/README.md). Without it /api/transcribe answers 503 and the parent marks by hand.
SPEECH_URL=
SPEECH_TOKEN=

# Optional. ReadBuddy's voice for stories and new lines: the Voice service in speech/app.py (same
# token as above). Without it the games use pre-made clips and, for anything else, the phone's voice.
VOICE_URL=

# Optional. The AI for the assistant, stories and the parent summary. DeepSeek is used first
# when its key is set, then Claude; with neither, built-in rules answer. https://platform.deepseek.com
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional. The public address used in share previews, the sitemap and robots.txt. On Vercel the
# production domain is picked up automatically, so this is only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=
